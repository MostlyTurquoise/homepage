---
import type { CollectionEntry, RenderedContent } from "astro:content";
import BaseHead from "../components/BaseHead.astro";
import Cassette from "../components/magnus-archives/Cassette.astro";
import TypewriterNote from "../components/magnus-archives/TypewriterNote.astro";
import { SITE_TITLE } from "../consts";
import { getCollection } from "astro:content";
import { render } from "astro:content";
import type { AstroComponentFactory } from "astro/runtime/server/index.js";

import Wood from "../assets/images/wood.jpg";
import CassetteRackTop from "../assets/images/cassetteracktop.png";
import CassetteRackShelf from "../assets/images/cassetterackshelf.png";
import CassetteImg from "../assets/images/cassette.png";

type EpisodeCollectionEntry = CollectionEntry<"magnusArchivesEpisodes"> & {
    data: { type: "episode" };
};

const episodes: [EpisodeCollectionEntry, AstroComponentFactory][] =
    await Promise.all(
        (await getCollection("magnusArchivesEpisodes"))
            .filter(
                (p): p is EpisodeCollectionEntry => p.data.type === "episode",
            )
            .sort((a, b) => a.data.number - b.data.number)
            .map(async (p) => [p, (await render(p)).Content]),
    );
---

<!doctype html>
<html lang="en">
    <head>
        <BaseHead
            title={SITE_TITLE + " | Magnus Archives theories"}
            description="My theories for the Magnus Archives"
        />
        <style
            define:vars={{
                woodImage: `url("${Wood.src}")`,
                cassetteRackTopImage: `url("${CassetteRackTop.src}")`,
                cassetteRackShelfImage: `url("${CassetteRackShelf.src}")`,
                cassetteImage: `url("${CassetteImg.src}")`,
            }}
        >
            body {
                font-family: var(--font-jmh-typewriter);
                background-image: var(--woodImage);
                height: 100vh;
                overflow: hidden;
            }

            .main-content {
                display: flex;
                flex-direction: row;
                justify-content: flex-start;
                align-items: stretch;
                height: 100vh;
                overflow: hidden;
            }

            .cassette-rack {
                width: min(30vw, 100vw);
                flex-grow: 0;
                /* padding: 0ch 3.5rem; */
                /* margin: 1rem; */
                /* background-image: var(--cassetteRackShelfImage); */
                /* outline: 1ch solid rgba(0.5, 0.5, 0.5, 0.3); */
                margin-right: 1vw;
                filter: drop-shadow(0.5ch 0.5ch 0.5ch #000);
                /* height: 100%; */
                overflow-y: scroll;
                overflow-x: hidden;
                flex-shrink: 0;
            }

            .cassette-rack-end {
                width: 100%;
                background-image: var(--cassetteRackTopImage);
                background-size: 100% 100%;
                height: 4vw;
            }

            .cassette-rack-bottom {
                transform: scaleY(-1);
            }

            .cassette-image {
                margin-left: 5vw;
                width: 22vw;
                height: 16vw;
                font-size: 0.5em;
                padding: 2.8vw 5.8vw;
                color: black;
                filter: drop-shadow(0.5ch 0.5ch 0.5ch #000);
                background-image: var(--cassetteImage);
                background-size: 100%;
                background-repeat: no-repeat;
            }

            .cassette-label {
                position: relative;
                bottom: 11.7rem;
                left: 2.7rem;
                height: 0rem;
                width: 20rem;
                overflow: visible;
                color: black;
                font-size: 0.5em;
            }

            .collapsible-note {
                height: 100%;
                overflow-y: scroll;
                flex-grow: 4;
                width: 100%;
            }

            .tabletop {
                width: 100%;
                flex-grow: 10;
                padding: 1vw;
            }

            .hint {
                margin-left: 25%;
                margin-top: 40%;
                width: 20rem;
                height: fit-content;
                background-color: lightcyan;
                color: black;
                font-family: var(--font-roboto);
                padding: 1rem;
                text-align: center;
            }

            .hint h1 {
                font-size: 1.2em;
                font-family: var(--font-roboto);
                font-weight: normal;
            }
        </style>
    </head>
    <body>
        <!-- <TypewriterNote>
            <h1>Hiya</h1>
            Hello
            <p>
                Hello words words words words words words words words
                words words words words words words words words words
                words words words words
            </p>
            <p>
                Words words words words words words words words words
                words words words words words words words words words
                words words words words
            </p>
        </TypewriterNote> -->
        <div class="main-content">
            <div class="cassette-rack">
                <div class="cassette-rack-end"></div>
                {episodes.map(([p, C]) => <Cassette {...p.data} />)}
                <div class="cassette-rack-end cassette-rack-bottom"></div>
            </div>
            <div class="tabletop">
                <div class="hint">
                    <h1>Hello and welcome to my Magnus Archives theories.</h1> Click
                    on an episode to the left to pull it up here
                </div>
                {
                    episodes.map(([p, C]) => (
                        <div
                            id={`note${p.data.number}`}
                            style="display: none;"
                            aria-hidden="true"
                            class="collapsible-note"
                        >
                            <div class="cassette-image">{p.data.title}</div>
                            <TypewriterNote>
                                <p>{p.data.listenedOn?.toLocaleDateString()}</p>
                                <C />
                            </TypewriterNote>
                        </div>
                    ))
                }
            </div>
        </div>
    </body>
</html>
