---
interface Props {
    link: string;
    download?: boolean;
    image: ImageMetadata;
    description?: string;
}
const { link, image, description = "", download = false } = Astro.props;
---

<style>
    a,
    span {
        font-size: 0;
        margin: 0.1rem;
    }
</style>

{
    link ? (
        <a href={link} download={download}>
            <img
                src={image.src}
                alt={`88x31 button reading '${description}'`}
                title={description}
            />
        </a>
    ) : (
        <span>
            <img
                src={image.src}
                alt={`88x31 button reading '${description}'`}
                title={description}
            />
        </span>
    )
}
